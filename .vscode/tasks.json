{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Maven: clean install (skip tests)ctivat",
            "type": "shell",
            "command": "mvn clean install -DskipTests",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Builds the project using Maven and skips tests"
        },
        {
            "label": "Activate Conda Env",
            "type": "shell",
            "command": "",
            "args": [
                "-i",
                "-c",
                "conda activate ppomatsimenv && echo Conda environment activated"
            ],
            "problemMatcher": [],
            "options": {
                "shell": {
                    "executable": "/bin/bash",
                }
            }
        }
    ]
}